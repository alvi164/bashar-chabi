# Bashar Chabi (বাসার চাবি) - Environment Variable Configuration Template
# NOTE: Do NOT place real production secrets or API keys in this file.

# Application Server Port
PORT=3000

# Client Configuration (Prefix with VITE_ for client accessibility)
VITE_APP_NAME="Bashar Chabi"
VITE_APP_URL="http://localhost:3000"
VITE_DEFAULT_LANGUAGE="bn"

# Firebase Client Configuration (To be connected in Phase 2)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase Emulator Configuration (Development Only)
VITE_USE_FIREBASE_EMULATOR="false"
VITE_FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"
VITE_FIRESTORE_EMULATOR_HOST="localhost:8080"

# Firebase Admin SDK (Server runtime only - Never expose to client)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
